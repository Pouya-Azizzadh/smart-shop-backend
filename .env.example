DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite is used by default (db.sqlite3) — no DATABASE_URL needed.

# In-memory WebSocket layer (no Redis required for local/demo use)
USE_INMEMORY_CHANNEL_LAYER=True

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

ESP_DEVICE_API_KEY=demo-esp-key
ESP_MQTT_ENABLED=False
ESP_DEVICE_TIMEOUT_SECONDS=300
